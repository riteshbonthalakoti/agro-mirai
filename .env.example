# AGRO MIRAI — environment variables
#
# Copy to .env for local dev (already gitignored): `cp .env.example .env`.
# Works as-is for the local demo after you set API_KEY. Lines that start
# with "# " and need a real key/URL are OFF by default — uncomment one only
# when you have the value; leaving them set to a <placeholder> would break
# startup (e.g. SUPABASE_* switches the app to Supabase). No real values
# below — it is never a source of truth for a secret.

# Path to the Earth Engine service-account JSON key. The key itself lives
# outside the repo (create a service account in Google Cloud Console ->
# IAM & Admin -> Service Accounts, register it for Earth Engine, download
# its JSON key; details in docs/TOOLING.md) — never commit it, never paste
# its contents here. Required by NDVIAdapter's live path; the cache
# fallback works without it.
# EE_SERVICE_ACCOUNT_KEY=/absolute/path/to/ee-service-account.json

# Open-Meteo (weather) and SoilGrids (soil) need no API key — no vars to
# set for those adapters. Listed here so this file stays the single place
# to check "does adapter X need an env var".

# Module 04 — SupabaseDataStore (prod persistence). Project URL and a
# service-role (or anon, depending on RLS posture chosen later) API key
# from the Supabase dashboard / `supabase projects list`. Never commit
# real values — see docs/TOOLING.md for the CLI commands to create/link
# a project and apply migrations/postgres/001_init.sql.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_KEY=<service-role-or-anon-key>

# Module 11 — Flask API layer.
# "development" or "production"; "testing" disables nothing special today
# but is the value the test suite sets.
FLASK_ENV=development
# SQLite file path for SQLiteDataStore. Swap for a Supabase connection
# string once the API talks to prod (repository interface stays the
# same either way).
DATABASE_URL=agro_mirai.db
# Shared secret checked against `Authorization: Bearer <API_KEY>` on the
# legacy /v1 routes (demo/backward-compat; the /v2 routes use real
# per-farmer OTP sessions instead). Make up any random string, e.g.
# `python -c "import secrets; print(secrets.token_hex(16))"`.
API_KEY=<choose-a-random-secret>
# The one Farmer id the /v1 routes serve (ADR 0003). Must already exist in
# the DataStore. For the bundled demo data, run tools/seed_fixture.py and
# use the fixture farmer's id: 11111111-1111-4111-8111-111111111111
FARMER_ID=11111111-1111-4111-8111-111111111111

# Module 16 — reliability & CI hardening.
# Sentry DSN from a Sentry project's Settings > Client Keys (DSN) page.
# Unset (or empty) is a supported no-op — the app runs fine locally
# without error monitoring.
# SENTRY_DSN=<https://...@o0.ingest.sentry.io/...>
# Per-API-key request budget passed straight to Flask-Limiter, e.g.
# "60 per minute". Leave unset for the built-in default.
RATE_LIMIT=60 per minute

# Module 19 — multi-tenant /v2 auth (real login/session, decisions/0017).
# Signs Flask's session cookie (api/app.py's app.secret_key). Already a
# required Render env var since Module 15/16 (render.yaml); no new
# secret was introduced for /v2's session auth — this is the same key,
# just newly load-bearing for real per-farmer login instead of only
# flash-message signing. Set to a long random value in prod, never the
# "dev-only-secret-not-for-prod" fallback api/app.py uses when unset.
FLASK_SECRET_KEY=<choose-a-long-random-secret>
# Per-remote-address budget on POST /v2/auth/request-otp specifically
# (Module 27: renamed from LOGIN_RATE_LIMIT since farmer auth moved from
# email+password to Name+Phone+OTP), on top of the general RATE_LIMIT
# above -- each request generates and logs a real OTP, so this bounds
# OTP-spam/phone-enumeration, not password brute-force.
OTP_RATE_LIMIT=5 per minute
# Module 56 — SMS delivery for the OTP above (docs/SMS_OTP_SETUP.md).
# "log" (default, dev only — the app refuses to start in production
# with this value), "test" (fixed codes for OTP_TEST_NUMBERS, no SMS
# sent), or "sms_gateway" (real SMS via a spare Android phone running
# the capcom6 SMS Gateway app).
OTP_PROVIDER=log
# "+91xxxxxxxxxx:123456,+91yyyyyyyyyy:654321" — only read when
# OTP_PROVIDER=test. Each listed number always gets its fixed code
# instead of a random one.
# OTP_TEST_NUMBERS=
# Required in production if OTP_PROVIDER=test is ever used there
# (an evaluator demo number logging in with a fixed code is a real
# security relaxation, not a default) — set this only when Ritesh
# explicitly asks.
# ALLOW_TEST_OTP=1
# Basic-auth credentials for the SMS Gateway for Android's cloud API
# (https://api.sms-gate.app), only read when OTP_PROVIDER=sms_gateway.
# Created when you register the gateway app on the spare Android phone.
# SMS_GATEWAY_USER=<gateway-username>
# SMS_GATEWAY_PASS=<gateway-password>
# Module 56 — the mobile app's SMS Retriever signature (11 chars),
# appended to every OTP SMS so the app auto-fills the code with no
# copy-paste. Get it from the app itself (modules/sms-retriever's
# getAppSignatures(), logged once on the Onboarding screen in dev) —
# debug and release currently share the same signing key
# (mobile/android/app/build.gradle), so one value covers both.
# Optional: omitting it just means the farmer types the code manually.
# SMS_APP_HASH=<11-char-hash>

# Module 21 — heavy-inference services on a separate Oracle Cloud VM
# (decisions/0019-deployment-architecture.md, docs/deploy/oracle-vm-setup.md).
# Both are optional: unset means "CNN image path / remote voice path
# unavailable," and the API degrades gracefully rather than failing —
# POST /fields/{field_id}/disease-risk/image falls back to the rule-based
# DiseaseRiskModel when CNN_SERVICE_URL is unset, unreachable, or slow.
# Base URL of the services/cnn-inference container, e.g.
# http://<oracle-vm-public-ip>:8001 (no trailing slash needed).
# CNN_SERVICE_URL=http://<oracle-vm-ip>:8001
# Request timeout in seconds for the CNN service call. Default 15 if unset.
CNN_SERVICE_TIMEOUT_S=15
# Base URL of the services/voice container, e.g.
# http://<oracle-vm-public-ip>:8002 — for RemoteVoiceService, not yet
# wired into any route as of Module 21 (see decisions/0019's known
# limitations).
# VOICE_SERVICE_URL=http://<oracle-vm-ip>:8002
VOICE_SERVICE_TIMEOUT_S=30

# Module 23 — /v2 voice endpoints (GET /v2/advisories/{id}/audio, POST
# /v2/stt) now actually call VOICE_SERVICE_URL above. TTS/STT are more
# expensive per call than a JSON read, so they get their own rate limits
# on top of the general RATE_LIMIT — see decisions/0020's section 7.
TTS_RATE_LIMIT=20 per minute
STT_RATE_LIMIT=10 per minute

# Module 24 (compatibility hardening) — CORS allowed origins for browser
# clients. Comma-separated list of exact origins (scheme + host + port).
# Unset means no CORS headers emitted — same-origin only (fine for curl
# and native mobile; required for Next.js SPA or React Native web build
# served from a different domain). Example:
#   CORS_ORIGINS=https://agro-mirai.vercel.app,http://localhost:3000
# SESSION_COOKIE_SAMESITE defaults to "None" (cross-origin cookie delivery
# with Secure flag in prod). Set to "Lax" if the frontend is always
# same-site as the API (no cross-origin cookie needed).
CORS_ORIGINS=http://localhost:3000
SESSION_COOKIE_SAMESITE=None

# ---------------------------------------------------------------------------
# Optional integrations. Every variable below is optional: leave it unset
# and that feature degrades (never crashes) — see each comment.
# ---------------------------------------------------------------------------

# Fallback weather source, tried only if Open-Meteo (the primary, no key
# needed) fails (decisions/0025). Free key: sign up at
# https://openweathermap.org/api -> "My API keys". Unset = fallback disabled.
# OPENWEATHER_API_KEY=<openweathermap-api-key>

# Module 40 — Sarvam AI is the PRIMARY voice provider for the MAIN API:
# speech-to-text, the answer to "ask by voice", text-to-speech and translation
# for en/kn/te/hi (src/agro_mirai/api/sarvam_client.py). ~1-3 s per call, no
# torch or Oracle VM needed, so it works on Render. Keys are tried in order.
# Get keys: https://console.sarvam.ai. On Render set these in the dashboard.
# Unset = falls back to the local voice service (VOICE_SERVICE_URL) / Gemini.
# SARVAM_API_KEY_1=<sarvam-key>
# SARVAM_API_KEY_2=<sarvam-key>
# SARVAM_API_KEY_3=<sarvam-key>

# Hard kill switch (2026-09-27): Ritesh's demo quota is nearly exhausted.
# Sarvam is disabled by default regardless of the keys above -- set this to
# 0 only when he explicitly says to re-enable it.
# SARVAM_DISABLED=1

# Module 30 — Gemini is now only the FALLBACK answerer for
# POST /v2/voice/ask (used when Sarvam is unavailable). Free tier, no card,
# but it returns 503 "high demand" often. Key: https://aistudio.google.com/apikey
# Unset = if Sarvam also fails, that endpoint returns a clean "unavailable"
# error; the rest of the API is unaffected.
# GEMINI_API_KEY=<gemini-api-key>
# Optional overrides (defaults: gemini-flash-latest, 20 seconds).
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_S=20
# Per-remote-address budget on POST /v2/voice/ask (default shown).
ASK_RATE_LIMIT=6 per minute

# AI cascade restructure: disease detection, advisory, and crop
# recommendation each now try a free-tier LLM tier first, before falling
# back to the existing CNN / rule-based models -- a second opinion ahead
# of the trained/rule-based path for reliability (see key_pool.py,
# gemini_client.py's ask_gemini_vision/ask_gemini_structured,
# crop_llm.py, advisory_llm.py). Up to 9 keys are round-robined per
# provider; unset slots are skipped, so fewer than 9 works too. Get keys:
# https://aistudio.google.com (no card required).
# GEMINI_API_KEY_1=<gemini-api-key>
# GEMINI_API_KEY_2=<gemini-api-key>
# GEMINI_API_KEY_3=<gemini-api-key>
# GEMINI_API_KEY_4=<gemini-api-key>
# GEMINI_API_KEY_5=<gemini-api-key>
# GEMINI_API_KEY_6=<gemini-api-key>
# GEMINI_API_KEY_7=<gemini-api-key>
# GEMINI_API_KEY_8=<gemini-api-key>
# GEMINI_API_KEY_9=<gemini-api-key>

# Backup pools for the same cascades, tried only if every Gemini key above
# is unavailable or rate-limited. Smaller pools are fine here -- Gemini is
# the primary. Get keys: https://openrouter.ai / https://console.groq.com
# (no card required for either free tier).
# OPENROUTER_API_KEY_1=<openrouter-key>
# OPENROUTER_API_KEY_2=<openrouter-key>
# OPENROUTER_API_KEY_3=<openrouter-key>
# GROQ_API_KEY_1=<groq-key>
# GROQ_API_KEY_2=<groq-key>
# GROQ_API_KEY_3=<groq-key>

# Disease-detection tier tried before the vision-LLM tier above: Kindwise
# Crop.Health, a dedicated plant-disease identification API
# (plant_disease_client.py). Signup grants a one-time batch of free
# identification credits per account rather than a renewing monthly
# quota -- expect this pool to stop contributing once those credits are
# used up, at which point the cascade falls through to the vision-LLM
# tier automatically (this is normal, not a fault). Get keys:
# https://kindwise.com (Crop.Health product; no card required for the
# free trial credits as of signup).
# PLANT_DISEASE_API_KEY_1=<kindwise-api-key>
# PLANT_DISEASE_API_KEY_2=<kindwise-api-key>
# PLANT_DISEASE_API_KEY_3=<kindwise-api-key>
# Optional override (default: 8 seconds).
PLANT_DISEASE_API_TIMEOUT_S=8

# BhashiniVoiceAdapter (src/agro_mirai/voice/bhashini_voice.py) is a stub
# behind the VoiceService interface and is NOT used by any route today.
# Only set these if you wire it in. Credentials from https://bhashini.gov.in
# (register -> ULCA/Udyat account -> API key page).
# BHASHINI_API_KEY=<key>
# BHASHINI_USER_ID=<user-id>
# BHASHINI_ULCA_API_KEY=<ulca-key>

# Module 39 — STT cloud fallback chain (services/voice/app.py).
# 9 keys across 3 platforms; tried in order before falling back to the
# local AI4Bharat model. All free tiers — Groq: 2000 req/day,
# OpenRouter: pay-as-you-go free credits, Sarvam AI: 500 req/day.
# Get Groq keys: https://console.groq.com — free, 2000 req/day, no card needed.
# Get Sarvam keys: https://console.sarvam.ai — free, 500 req/day, Indian languages.
# Any unset key is skipped silently; if all 6 fail, AI4Bharat handles it locally.
# These live in services/voice container env, NOT the main API.
# GROQ_API_KEY_1=gsk_...
# GROQ_API_KEY_2=gsk_...
# GROQ_API_KEY_3=gsk_...
# SARVAM_API_KEY_1=<sarvam-key>
# SARVAM_API_KEY_2=<sarvam-key>
# SARVAM_API_KEY_3=<sarvam-key>

# Read by the standalone services under services/, NOT by the main API.
# Set them in that service's own container environment (docker-compose.yml).
# CNN_WEIGHTS_PATH=/models/disease_cnn_mobilenetv2.pt
# CNN_CLASS_NAMES_PATH=/models/disease_cnn_class_names.json
# PORT=8001   # services/cnn-inference default; services/voice defaults to 8002
