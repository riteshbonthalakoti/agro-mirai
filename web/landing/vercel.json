{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"AgroMirai-v2.8.13.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable, no-transform" },
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/download", "destination": "/download.html" },
    { "source": "/admin/", "destination": "https://agromirai-admin.vercel.app/index.html" },
    { "source": "/admin/style.css", "destination": "https://agromirai-admin.vercel.app/style.css" },
    { "source": "/admin/tailwind.generated.css", "destination": "https://agromirai-admin.vercel.app/tailwind.generated.css" },
    { "source": "/admin/admin.js", "destination": "https://agromirai-admin.vercel.app/admin.js" },
    { "source": "/admin/logo-mark.png", "destination": "https://agromirai-admin.vercel.app/logo-mark.png" },
    { "source": "/admin/favicon.ico", "destination": "https://agromirai-admin.vercel.app/favicon.ico" },
    { "source": "/admin/:path*", "destination": "https://agro-mirai-xi27.onrender.com/admin/:path*" },
    { "source": "/v2/:path*", "destination": "https://agro-mirai-xi27.onrender.com/v2/:path*" }
  ]
}
