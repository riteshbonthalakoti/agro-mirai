{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/(.*)\\.apk",
      "headers": [
        { "key": "Content-Type", "value": "application/vnd.android.package-archive" },
        { "key": "Content-Disposition", "value": "attachment; filename=\"agromirai2.8.17.apk\"" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable, no-transform" },
        { "key": "Accept-Ranges", "value": "bytes" },
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ],
  "redirects": [
    { "source": "/admin", "destination": "/admin/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/download", "destination": "/download.html" },
    { "source": "/admin/login", "destination": "https://agro-mirai-xi27.onrender.com/admin/login" },
    { "source": "/admin/logout", "destination": "https://agro-mirai-xi27.onrender.com/admin/logout" },
    { "source": "/admin/forgot-password", "destination": "https://agro-mirai-xi27.onrender.com/admin/forgot-password" },
    { "source": "/admin/reset-password", "destination": "https://agro-mirai-xi27.onrender.com/admin/reset-password" },
    { "source": "/v2/:path*", "destination": "https://agro-mirai-xi27.onrender.com/v2/:path*" }
  ]
}
