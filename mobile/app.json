{
  "expo": {
    "name": "Agro Mirai",
    "slug": "agro-mirai",
    "version": "2.2.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FDF8EE",
        "foregroundImage": "./assets/adaptive-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.ritesh1918.mobile",
      "versionCode": 16,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.CAMERA",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "favicon": "./assets/Agro_Mirai_Logo.png"
    },
    "plugins": [
      "@maplibre/maplibre-react-native",
      "expo-audio",
      [
        "expo-splash-screen",
        {
          "image": "./assets/logo-mark.png",
          "imageWidth": 160,
          "backgroundColor": "#F1EEE1",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#2E7D32"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Agro Mirai needs camera access to scan crop leaves for disease detection."
        }
      ],
      "expo-asset",
      "expo-secure-store",
      "./plugins/withCleartextTraffic",
      "./plugins/withPinnedJdk",
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-background-task",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "buildArchs": ["arm64-v8a"]
          }
        }
      ]
    ],
    "owner": "ritesh.bonthalakoti",
    "updates": {
      "url": "https://u.expo.dev/68847f91-ef3a-429b-b3cb-d8398450af47"
    },
    "extra": {
      "eas": {
        "projectId": "68847f91-ef3a-429b-b3cb-d8398450af47"
      }
    }
  }
}
